{
  "cleanUrls": true,
  "redirects": [
    { "source": "/como-funciona", "destination": "/como", "permanent": true },
    { "source": "/como-funciona/", "destination": "/como", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
